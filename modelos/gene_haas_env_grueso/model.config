<?xml version="1.0" ?>
<model>
  <name>gene_haas_env_grueso</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <description>Sótano de Gene Haas con paredes exteriores de ~0.25 m (recrecidas hacia fuera, interior intacto) y ventanas altas y estrechas (z 2.10-2.50 m). Reutiliza Sotano.dae de gene_haas_env sin cambios + cajas. Generado por herramientas/generar_gene_haas_env_grueso.py. Medidas APROXIMADAS.</description>
</model>

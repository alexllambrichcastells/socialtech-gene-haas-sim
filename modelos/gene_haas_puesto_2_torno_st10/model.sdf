<?xml version="1.0" ?>
<sdf version="1.9">
  <!-- Malla centrada en XY con la base en z=0 (bbox 3.428 x 1.669 x 1.864 m): no necesita offset. -->
  <model name="gene_haas_puesto_2_torno_st10">
    <static>true</static>
    <link name="base">
      <!-- Collision: baja (z 0-0.3) ajustada a lo visible a la altura del robot; alta = caja envolvente (herramientas/ajustar_colisiones_bajas.py) -->
      <collision name="collision_baja">
        <pose>0.3522 -0.0975 0.1500 0 0 0</pose>
        <geometry>
          <box>
            <size>2.0846 1.3403 0.3000</size>
          </box>
        </geometry>
      </collision>
      <collision name="collision_alta">
        <pose>0.0000 0.0000 1.0819 0 0 0</pose>
        <geometry>
          <box>
            <size>3.4276 1.6687 1.5638</size>
          </box>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://gene_haas_puesto_2_torno_st10/meshes/03_Torno_ST10.dae</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.45 0.45 0.48 1</ambient>
          <diffuse>0.45 0.45 0.48 1</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>

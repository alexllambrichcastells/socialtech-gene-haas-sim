<?xml version="1.0" ?>
<sdf version="1.9">
  <!-- Entrenador de PLC de sobremesa (atrezo; modelo propio, solo primitivas, estático, sin lógica ni cableado). Medidas APROXIMADAS:
       panel 0.45 x 0.30 m inclinado 20 grados hacia atrás sobre una base de 0.47 x 0.30 x 0.03 m; altura total ~0.32 m.
       En la cara: carril DIN con CPU y 3 módulos de E/S, pilotos verde/ámbar/rojo, pulsadores de marcha (verde) y paro (rojo),
       seta de emergencia y una fila de 16 bornas. Origen = centro de la base apoyada (pose z = altura del tablero);
       +x local = hacia donde mira la cara de mandos (el alumno). Collision: caja envolvente simple (queda sobre la mesa). -->
  <model name="gene_haas_entrenador_plc">
    <static>true</static>

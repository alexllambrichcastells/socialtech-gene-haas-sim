        <material><ambient>0.07 0.07 0.07 1</ambient><diffuse>0.07 0.07 0.07 1</diffuse></material>
      </visual>
      <visual name="pierna_izq">
        <pose>0 0.1 0.46 0 0 0</pose>
        <geometry><cylinder><radius>0.065</radius><length>0.8</length></cylinder></geometry>

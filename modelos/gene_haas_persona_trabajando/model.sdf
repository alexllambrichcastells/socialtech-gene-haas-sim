<?xml version="1.0" ?>
<sdf version="1.9">
  <!-- Persona de pie trabajando en un banco (modelo propio, solo primitivas, estático, sin animación). Medidas APROXIMADAS:
       1.77 m de alto, hombros 0.46 m, tronco ligeramente inclinado hacia delante y brazos flexionados con las manos a ~0.99 m
       (para un tablero a 0.92 m) y 0.44 m por delante de los pies. Origen = centro entre los pies en el suelo; +x local = hacia
       donde mira (el tablero). Colocar los pies a ~0.33 m del borde del tablero. Collision simplificada: piernas, cadera, torso y
       cabeza (los brazos, sobre el tablero, sin collision). A la altura del LiDAR (0.20 m) se ven las dos piernas. -->
  <model name="gene_haas_persona_trabajando">
    <static>true</static>
    <link name="persona">
      <visual name="zapato_izq">
        <pose>0.03 0.1 0.03 0 0 0</pose>

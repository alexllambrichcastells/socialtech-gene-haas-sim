<?xml version="1.0" ?>
<sdf version="1.9">
  <!-- Silla (modelo propio, primitivas). Medidas APROXIMADAS: asiento 0.45 x 0.45 m a 0.42-0.47 m, respaldo 0.42 m de ancho
       hasta 0.86 m, patas de 12 mm de radio. Origen = centro de la silla en el suelo; +x local = hacia donde mira quien se sienta
       (el respaldo queda en -x). Collision = las mismas piezas (patas incluidas: el LiDAR a 0.20 m solo ve las patas). -->
  <model name="gene_haas_silla">
    <static>true</static>
    <link name="silla">

<?xml version="1.0" ?>
<sdf version="1.9">
  <!-- Malla centrada en XY con la base en z=0 (bbox 3.197 x 2.237 x 2.724 m): no necesita offset. -->
  <model name="gene_haas_fresadora_vf2">
    <static>true</static>
    <link name="base">
      <!-- Collision: baja (z 0-0.3) ajustada a lo visible a la altura del robot; alta = caja envolvente (herramientas/ajustar_colisiones_bajas.py) -->
      <collision name="collision_baja">
        <pose>-0.4103 0.0644 0.1500 0 0 0</pose>
        <geometry>
          <box>
            <size>2.3659 1.8229 0.3000</size>
          </box>
        </geometry>
      </collision>
      <collision name="collision_alta">
        <pose>0.0000 0.0000 1.5121 0 0 0</pose>
        <geometry>
          <box>
            <size>3.1969 2.2371 2.4241</size>
          </box>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://gene_haas_fresadora_vf2/meshes/04_Fresadora_VF2.dae</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.30 0.50 0.35 1</ambient>
          <diffuse>0.30 0.50 0.35 1</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>

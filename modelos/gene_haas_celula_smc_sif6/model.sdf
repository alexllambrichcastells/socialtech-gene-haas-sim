<?xml version="1.0" ?>
<sdf version="1.9">
  <!-- Malla centrada en XY con la base en z=0 (bbox 1.232 x 1.000 x 1.6655 m): no necesita offset. -->
  <model name="gene_haas_celula_smc_sif6">
    <static>true</static>
    <link name="base">
      <collision name="collision">
        <pose>0 0 0.8327 0 0 0</pose>
        <geometry>
          <box>
            <size>1.232 1.000 1.6655</size>
          </box>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://gene_haas_celula_smc_sif6/meshes/SIF6-0-CE.dae</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.45 0.55 0.65 1</ambient>
          <diffuse>0.45 0.55 0.65 1</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>

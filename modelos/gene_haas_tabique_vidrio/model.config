<?xml version="1.0" ?>
<model>
  <name>gene_haas_tabique_vidrio</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <description>Tabique de vidrio del laboratorio Gene Haas: separa la sala principal (puntos 2-9) de la zona de entrada (punto 1). Visual translúcido con malla DAE, puerta de 1.20 x 2.00 m; collision simplificada en 3 cajas (dos paños y dintel) que deja libre la puerta.</description>
</model>

<?xml version="1.0" ?>
<sdf version="1.9">
  <!-- Puesto de ordenador (modelo propio, primitivas). Medidas APROXIMADAS: monitor 0.55 x 0.33 m, teclado 0.44 x 0.15 m,
       torre 0.42 x 0.18 x 0.40 m. Origen = borde de la mesa a nivel del suelo; +x local hacia dentro de la mesa.
       La persona se sienta en -x: el monitor y el teclado miran hacia ella. Huella sobre la mesa: x 0.095..0.66, y -0.33..0.48. -->
  <model name="gene_haas_puesto_ordenador">
    <static>true</static>
    <link name="puesto">
      <visual name="monitor_marco">
        <pose>0.4500 0.000 1.1150 0 0 0</pose>
        <geometry><box><size>0.03 0.55 0.33</size></box></geometry>
        <material><ambient>0.04 0.04 0.045 1</ambient><diffuse>0.04 0.04 0.045 1</diffuse></material>
      </visual>

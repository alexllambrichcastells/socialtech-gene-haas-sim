<?xml version="1.0" ?>
<sdf version="1.9">
  <!-- Malla centrada en XY con la base en z=0 (bbox 3.296 x 2.251 x 2.005 m): no necesita offset. -->
  <model name="gene_haas_torno_st20y">
    <static>true</static>
    <link name="base">
      <!-- Collision: baja (z 0-0.3) ajustada a lo visible a la altura del robot; alta = caja envolvente (herramientas/ajustar_colisiones_bajas.py) -->
      <collision name="collision_baja">
        <pose>0.1043 -0.0003 0.1500 0 0 0</pose>
        <geometry>
          <box>
            <size>2.8671 2.0226 0.3000</size>
          </box>
        </geometry>
      </collision>
      <collision name="collision_alta">
        <pose>0.0000 0.0000 1.1527 0 0 0</pose>
        <geometry>
          <box>
            <size>3.2963 2.2507 1.7054</size>
          </box>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://gene_haas_torno_st20y/meshes/09_Torno_ST20Y.dae</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.25 0.45 0.65 1</ambient>
          <diffuse>0.25 0.45 0.65 1</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>
